{
  "name": "mangaforever",
  "version": "1.0.0",
  "private": true,
  "description": "MangaForEver \u2014 Discover. Track. Review. Explore.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "npm run build -w @mangaforever/shared && prisma generate",
    "dev": "npm run build -w @mangaforever/shared && concurrently -n api,web -c magenta,cyan \"npm run dev -w @mangaforever/api\" \"npm run dev -w @mangaforever/web\"",
    "build": "npm run build -w @mangaforever/shared && npm run db:generate && npm run build -w @mangaforever/api && npm run build -w @mangaforever/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "npm run build -w @mangaforever/shared && npm run test -w @mangaforever/api",
    "typecheck": "npm run typecheck -w @mangaforever/shared && npm run typecheck -w @mangaforever/api && npm run typecheck -w @mangaforever/web",
    "lint": "npm run lint -w @mangaforever/web",
    "start:api": "npm run start -w @mangaforever/api",
    "start:web": "npm run start -w @mangaforever/web",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "local": "node scripts/local.mjs",
    "local:dev": "node scripts/local.mjs --dev",
    "db:link-anilist": "node scripts/link-anilist.mjs",
    "db:import-anilist": "tsx prisma/import-anilist.ts",
    "site:build": "tsx scripts/build-site.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^18.0.7",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.16.3"
  }
}
