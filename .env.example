# ─────────────────────────────────────────────────────────────
# MangaForEver environment — copy to .env and fill in.
# Placeholder values only. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL 14+; Neon / Supabase / local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mangaforever"
# Separate database for the automated tests (it gets truncated!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mangaforever_test"

# ── API (apps/api)
PORT=4000
# Interface to bind (leave unset on hosting platforms; scripts/local.mjs sets 127.0.0.1)
# HOST=127.0.0.1
NODE_ENV=development
# Browser origins allowed to call the API directly (comma-separated). The web app's own origin.
WEB_ORIGIN="http://localhost:3000"
# Public URL of the web app — used to build password-reset links.
APP_URL="http://localhost:3000"
SESSION_TTL_DAYS=30
# Cookies are Secure automatically when NODE_ENV=production. Override with true/false if needed.
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API (Render/Railway LB + Vercel rewrite = 2 in production).
TRUST_PROXY=1
LOG_LEVEL=info
# "anilist" enables live AniList imports from the admin panel; "none" = local catalog only.
METADATA_PROVIDER=anilist
ANILIST_API_URL="https://graphql.anilist.co"
# Shared secret between web and API so server-side rendering isn't throttled by the per-IP limit.
# Generate with: openssl rand -hex 32   (set the SAME value on the web app)
# INTERNAL_API_TOKEN="replace-with-a-long-random-string"

# ── Accounts
# New accounts must confirm their email before signing in (set false only for local testing).
REQUIRE_EMAIL_VERIFICATION=true
# Comma-separated emails that are always admins (applied at sign-in and on API start).
ADMIN_EMAILS=""

# ── Email (Resend). Without a key, emails are printed to the API log instead of sent.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Use onboarding@resend.dev until you verify your own domain in Resend.
MAIL_FROM="MangaForEver <onboarding@resend.dev>"

# ── Automatic updates
# Shared secret for POST /internal/jobs/<job>; set the same value as the JOBS_TOKEN secret in GitHub Actions.
# Generate with: openssl rand -hex 32
# JOBS_TOKEN="replace-with-a-long-random-string"
# Where new-chapter information comes from: "mangadex" (public API) or "none".
CHAPTER_PROVIDER=mangadex
MANGADEX_API_URL="https://api.mangadex.org"
# Chapter languages to track, comma-separated (MangaDex language codes).
CHAPTER_LANGUAGES=en

# ── Push notifications (optional). Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ── Web (apps/web)
# Where the Next.js server reaches the API (server-side fetches + /api/v1 rewrite).
API_URL="http://localhost:4000"
# Public API URL, only used to link to the Swagger docs.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Public address of the site, used for links, the sitemap and social previews.
SITE_URL="http://localhost:3000"

# ── Seed accounts (npm run db:seed). Change these before seeding anything public.
SEED_ADMIN_EMAIL="admin@mangaforever.local"
SEED_ADMIN_PASSWORD="ChangeMe-Admin-1"
SEED_MODERATOR_EMAIL="moderator@mangaforever.local"
SEED_MODERATOR_PASSWORD="ChangeMe-Mod-1"
SEED_DEMO_PASSWORD="DemoReader-1"
